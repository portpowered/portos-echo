# Build output
/target/
/out/
/dist/
/.cache/

# Bench and run artifacts stay outside git (docs/program/rules.md)
/artifacts/
*.wav
*.ogg
*.opus
*.mp4

# Local secrets and editor files
.env
.env.*
*.pem
.DS_Store
.idea/
.vscode/

# Factory lane worktrees and local factory state (factory/docs/operating-policy.md)
/.claude/worktrees/
/docs/temp/

# Factory lane working files: setup-workspace writes these into every lane
# worktree, and they must never be committed
/prd.json
/prd.md
/progress.md
/progress.txt
/problems.md

# Factory runtime state written into the checkout the daemon runs from
/.you-agent-factory/
/tasks/todo/
/tasks/done/
/factory/logs/
/factory/inputs/**
!/factory/inputs/**/
!/factory/inputs/**/.gitkeep
__pycache__/
/crates/echo-bridge/logs/
