{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Lab firmware probe manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "probe_timestamp",
    "source",
    "build",
    "hashes",
    "input_devices",
    "display",
    "mixer",
    "keyword_models"
  ],
  "properties": {
    "probe_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "pattern": "^echo-lab probe [0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incremental",
        "sdk",
        "device",
        "fingerprint",
        "kernel"
      ],
      "properties": {
        "incremental": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "integer",
          "minimum": 1
        },
        "device": {
          "const": "athena"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "md5",
          "pinned_md5",
          "comparison"
        ],
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "/system/lib/libpryon.so",
              "/system/vendor/lib/libasp.so",
              "/system/lib/libaspclient.so",
              "/system/lib/libaudioflinger.so",
              "/system/vendor/lib/hw/audio.primary.mt8183.so",
              "/system/lib/libwakewordserver_jni.so"
            ]
          },
          "md5": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "pinned_md5": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "comparison": {
            "enum": [
              "match",
              "differs"
            ]
          }
        }
      }
    },
    "input_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "capabilities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "density"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "density": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mixer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "values"
      ],
      "properties": {
        "name": {
          "const": "Master TAS5805m Playback Volume"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "keyword_models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
