-P INPUT DROP
-P OUTPUT DROP
-N echo_out
-A OUTPUT -j echo_out
-A INPUT ! -i lo -p tcp -m tcp --dport 5555 -j DROP
-A echo_out -p tcp -m tcp --dport 5555 -m owner ! --uid-owner 0 -j DROP
-A echo_out -o lo -j RETURN
-A echo_out -d fe80::/10 -j RETURN
-A echo_out -d fc00::/7 -j RETURN
-A echo_out -d ff02::/16 -j RETURN
-A echo_out -d 2001:db8::53/128 -p udp -m udp --dport 53 -j RETURN
-A echo_out -d 2001:db8::53/128 -p tcp -m tcp --dport 53 -j RETURN
-A echo_out -m owner --gid-owner 3990 -j RETURN
-A echo_out -j DROP
-A OUTPUT -o wlan0 -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -i wlan0 -p tcp -m state --state RELATED,ESTABLISHED -j ACCEPT
-A INPUT -i wlan0 -p udp -m state --state RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p ipv6-icmp -j ACCEPT
-A INPUT -i wlan0 -p udp -m udp --sport 547 --dport 546 -j ACCEPT
