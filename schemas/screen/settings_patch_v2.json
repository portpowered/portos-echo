{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsPatchV2",
  "type": "object",
  "properties": {
    "settings": {
      "$ref": "#/$defs/SettingsFieldsV2"
    },
    "version": {
      "$ref": "#/$defs/SettingsVersionV2"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "settings"
  ],
  "$defs": {
    "AgentPatchV2": {
      "type": "object",
      "properties": {
        "daily_request_cap": {
          "$ref": "#/$defs/DailyCapV1"
        },
        "max_tool_calls": {
          "description": "Deprecated compatibility input. Accepted and ignored without updating the settings overlay.",
          "type": "integer",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1
        },
        "task_deadline_seconds": {
          "description": "Deprecated compatibility input. Accepted and ignored without updating the settings overlay.",
          "type": "integer",
          "format": "uint32",
          "maximum": 600,
          "minimum": 5
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "CodexPatchV2": {
      "type": "object",
      "properties": {
        "delegate_effort": {
          "type": "string"
        },
        "delegate_model": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "web_search": {
          "$ref": "#/$defs/WebSearchV2"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "DailyCapV1": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "HomeSettingsV2": {
      "type": "object",
      "properties": {
        "agent_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HomeToolGroupV2"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_tools"
      ]
    },
    "HomeToolGroupV2": {
      "type": "string",
      "enum": [
        "notes",
        "prompts"
      ]
    },
    "PortosPermissionsPatchV2": {
      "type": "object",
      "properties": {
        "allow_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortosToolV2"
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortosScopeV2"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "PortosScopeV2": {
      "type": "string",
      "enum": [
        "endpoint:read",
        "endpoint:write",
        "message:send",
        "group:read",
        "group:manage",
        "subscription:read",
        "subscription:write"
      ]
    },
    "PortosToolV2": {
      "type": "string",
      "enum": [
        "control",
        "endpoint_query",
        "endpoint_show",
        "endpoint_manage",
        "group_query",
        "group_manage",
        "guide",
        "subscription_list",
        "subscription_inspect",
        "subscription_cancel",
        "subscription_label_edit"
      ]
    },
    "SettingsFieldsV2": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentPatchV2"
        },
        "codex": {
          "$ref": "#/$defs/CodexPatchV2"
        },
        "home": {
          "$ref": "#/$defs/HomeSettingsV2"
        },
        "portos": {
          "$ref": "#/$defs/PortosPermissionsPatchV2"
        },
        "voice": {
          "$ref": "#/$defs/VoicePatchV1"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "SettingsVersionV2": {
      "type": "integer",
      "const": 2
    },
    "VoicePatchV1": {
      "description": "Sparse editable leaves. Effective ranges/voices are validated by echo-config.",
      "type": "object",
      "properties": {
        "session_listen_enabled": {
          "type": "boolean"
        },
        "session_listen_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "WebSearchV2": {
      "type": "string",
      "enum": [
        "live",
        "cached",
        "disabled"
      ]
    }
  }
}
