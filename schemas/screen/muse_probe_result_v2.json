{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MuseProbeResultV2",
  "type": "object",
  "properties": {
    "reachable": {
      "type": "boolean"
    },
    "reason": {
      "$ref": "#/$defs/MuseProbeReasonV2"
    },
    "version": {
      "$ref": "#/$defs/SettingsVersionV2"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "reachable"
  ],
  "$defs": {
    "MuseProbeReasonV2": {
      "type": "string",
      "enum": [
        "unconfigured",
        "invalid_configuration",
        "unauthorized",
        "unavailable",
        "unexpected_response"
      ]
    },
    "SettingsVersionV2": {
      "type": "integer",
      "const": 2
    }
  }
}
