{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "properties": {
    "data": true,
    "header": {
      "$ref": "#/$defs/Header"
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      }
    }
  },
  "required": [
    "header",
    "payload"
  ],
  "$defs": {
    "Header": {
      "type": "object",
      "properties": {
        "data": true,
        "data_length": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "payload_length": {
          "type": "integer",
          "format": "uint",
          "default": 0,
          "minimum": 0
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    }
  }
}
