{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Lab milestone report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "result",
    "placement",
    "build_commit",
    "device",
    "evidence",
    "checks",
    "limitations",
    "tier",
    "driver",
    "scenario_digest",
    "hassmic_commit",
    "bench_session_ids"
  ],
  "properties": {
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "manual_observation"
      ]
    },
    "placement": {
      "const": "bridge_pc"
    },
    "build_commit": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "model",
        "firmware_hash"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "firmware_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6"
      ]
    },
    "driver": {
      "enum": [
        "sim",
        "cloud",
        "device"
      ]
    },
    "scenario_digest": {
      "type": "string",
      "minLength": 1
    },
    "hassmic_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "bench_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_observation": {
      "type": "object",
      "required": [
        "observer",
        "observation"
      ],
      "properties": {
        "observer": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "manual_observation"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "manual_observation"
        ]
      }
    }
  ]
}
