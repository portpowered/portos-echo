{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Lab milestone report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "result",
    "placement",
    "build_commit",
    "device",
    "evidence",
    "checks",
    "limitations",
    "tier",
    "driver",
    "scenario_digest",
    "hassmic_commit",
    "bench_session_ids"
  ],
  "properties": {
    "step_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "iteration",
          "attempts",
          "first_try_woke"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "iteration": {
            "type": "integer",
            "minimum": 0
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "first_try_woke": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "talkback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_steps",
        "first_try_wakes",
        "first_try_wake_rate",
        "replay_count"
      ],
      "properties": {
        "eligible_steps": {
          "type": "integer",
          "minimum": 0
        },
        "first_try_wakes": {
          "type": "integer",
          "minimum": 0
        },
        "first_try_wake_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "replay_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "manual_observation"
      ]
    },
    "placement": {
      "const": "bridge_pc"
    },
    "build_commit": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "model",
        "firmware_hash"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "firmware_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6"
      ]
    },
    "driver": {
      "enum": [
        "sim",
        "cloud",
        "device"
      ]
    },
    "scenario_digest": {
      "type": "string",
      "minLength": 1
    },
    "hassmic_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "bench_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_observation": {
      "type": "object",
      "required": [
        "observer",
        "observation"
      ],
      "properties": {
        "observer": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "run_id",
              "count"
            ],
            "properties": {
              "event": {
                "const": "wyoming.mic_frames"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "case",
              "run_id",
              "delegation_id",
              "tools_call_count",
              "commentary_count",
              "screen",
              "transcript",
              "capture_bytes",
              "reply_pcm_bytes",
              "endpoint_to_first_pcm_us"
            ],
            "properties": {
              "event": {
                "const": "m4.case"
              },
              "case": {
                "enum": [
                  "success",
                  "http500"
                ]
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "delegation_id": {
                "type": "string",
                "minLength": 1
              },
              "tools_call_count": {
                "const": 1
              },
              "commentary_count": {
                "const": 1
              },
              "screen": {
                "const": "speaking"
              },
              "transcript": {
                "type": "string",
                "minLength": 1
              },
              "capture_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "reply_pcm_bytes": {
                "const": 9600
              },
              "endpoint_to_first_pcm_us": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "case",
              "run_id",
              "delegation_id",
              "task_id",
              "gadget_session_id",
              "report_task_id",
              "transcript",
              "delegation_count",
              "muse_submit_count",
              "progress_count",
              "terminal_count",
              "completed_count",
              "failed_count",
              "spoken_reply_count",
              "gadget_submit_count",
              "report_accepted_count",
              "report_attempt_count",
              "reply_pcm_bytes",
              "client_tool_call_count",
              "responses_request_count",
              "retryable",
              "deadline_seconds"
            ],
            "properties": {
              "event": {"const": "m7.case"},
              "case": {
                "enum": [
                  "success",
                  "no_report"
                ]
              },
              "run_id": {"type": "string", "minLength": 1},
              "delegation_id": {"type": "string", "minLength": 1},
              "task_id": {"type": "string", "minLength": 1},
              "gadget_session_id": {"type": "string", "minLength": 1},
              "report_task_id": {"type": "string"},
              "transcript": {"type": "string", "minLength": 1},
              "delegation_count": {"const": 1},
              "muse_submit_count": {"const": 1},
              "progress_count": {"type": "integer", "minimum": 1},
              "terminal_count": {"const": 1},
              "completed_count": {"type": "integer", "minimum": 0, "maximum": 1},
              "failed_count": {"type": "integer", "minimum": 0, "maximum": 1},
              "spoken_reply_count": {"const": 1},
              "commentary_count": {"const": 1},
              "native_tool_call_count": {"const": 1},
              "native_append_count": {"const": 1},
              "legacy_dispatch_count": {"const": 0},
              "model_tool_output": {"type": "string", "minLength": 1},
              "gadget_submit_count": {"const": 1},
              "report_accepted_count": {"type": "integer", "minimum": 0, "maximum": 1},
              "report_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
              "reply_pcm_bytes": {"const": 9600},
              "client_tool_call_count": {"const": 0},
              "responses_request_count": {"enum": [0, 2]},
              "retryable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
            },
            "allOf": [
              {
                "if": {"required": ["commentary_count"]},
                "then": {
                  "properties": {
                    "responses_request_count": {"const": 0},
                    "deadline_seconds": {"minimum": 5},
                    "native_tool_call_count": false,
                    "native_append_count": false,
                    "legacy_dispatch_count": false,
                    "model_tool_output": false
                  }
                },
                "else": {
                  "required": ["native_tool_call_count", "native_append_count", "legacy_dispatch_count", "model_tool_output"],
                  "properties": {
                    "responses_request_count": {"const": 2}
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "case": {"const": "success"}
                  },
                  "required": [
                    "case"
                  ]
                },
                "then": {
                  "properties": {
                    "completed_count": {"const": 1},
                    "failed_count": {"const": 0},
                    "report_accepted_count": {"const": 1},
                    "report_attempt_count": {"const": 1},
                    "retryable": {"type": "null"}
                  }
                },
                "else": {
                  "properties": {
                    "completed_count": {"const": 0},
                    "failed_count": {"const": 1},
                    "report_accepted_count": {"const": 0},
                    "report_attempt_count": {"const": 0},
                    "retryable": {"const": false},
                    "report_task_id": {"const": ""}
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "m1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_before_first_wake",
        "streamed_wakes",
        "bridge_restarts",
        "hassmic_host_restarts",
        "mute_status"
      ],
      "properties": {
        "ready_before_first_wake": {
          "type": "integer",
          "minimum": 0
        },
        "streamed_wakes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bridge_generation",
              "run_id",
              "mic_frames"
            ],
            "properties": {
              "bridge_generation": {
                "type": "integer",
                "minimum": 1
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "mic_frames": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "const": "wake_clip"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "minLength": 64,
                    "maxLength": 64
                  }
                }
              },
              "play_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "bridge_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "hassmic_host_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "mute_status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "mute_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "received_frames",
            "forwarded_frames"
          ],
          "properties": {
            "received_frames": {
              "type": "integer",
              "minimum": 0
            },
            "forwarded_frames": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "wake_clip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "sample_rate_hz",
            "duration_ms"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "sample_rate_hz": {
              "enum": [
                16000,
                48000
              ]
            },
            "duration_ms": {
              "type": "number",
              "minimum": 500,
              "maximum": 10000
            }
          }
        },
        "plays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "iteration",
              "source"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0
              },
              "iteration": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "const": "wake_clip"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "minLength": 64,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mute_status": {
                "const": "pass"
              }
            },
            "required": [
              "mute_status"
            ]
          },
          "then": {
            "required": [
              "mute_window"
            ]
          }
        }
      ]
    },
    "link_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link",
        "tools_list",
        "tool_call",
        "forced_refresh",
        "replay_rejected",
        "relink_error",
        "restart_grant_kept",
        "unlink"
      ],
      "properties": {
        "link": {
          "type": "integer",
          "minimum": 0
        },
        "tools_list": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call": {
          "type": "integer",
          "minimum": 0
        },
        "forced_refresh": {
          "type": "integer",
          "minimum": 0
        },
        "replay_rejected": {
          "type": "integer",
          "minimum": 0
        },
        "relink_error": {
          "type": "integer",
          "minimum": 0
        },
        "restart_grant_kept": {
          "type": "integer",
          "minimum": 0
        },
        "unlink": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "m6": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui_states",
        "frame_count",
        "frame_ms",
        "return_state",
        "reply_pcm_bytes",
        "host_pcm_bytes",
        "host_nonzero_bytes"
      ],
      "properties": {
        "ui_states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "state"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "type": "object"
              }
            }
          }
        },
        "return_state": {
          "type": "object"
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reply_pcm_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "host_pcm_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "host_nonzero_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "manual_observation"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "manual_observation"
        ]
      }
    }
  ]
}
