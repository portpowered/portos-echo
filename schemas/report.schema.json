{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Lab milestone report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "result",
    "placement",
    "build_commit",
    "device",
    "evidence",
    "checks",
    "limitations",
    "tier",
    "driver",
    "scenario_digest",
    "hassmic_commit",
    "bench_session_ids"
  ],
  "properties": {
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "manual_observation"
      ]
    },
    "placement": {
      "const": "bridge_pc"
    },
    "build_commit": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "model",
        "firmware_hash"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "firmware_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6"
      ]
    },
    "driver": {
      "enum": [
        "sim",
        "cloud",
        "device"
      ]
    },
    "scenario_digest": {
      "type": "string",
      "minLength": 1
    },
    "hassmic_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "bench_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_observation": {
      "type": "object",
      "required": [
        "observer",
        "observation"
      ],
      "properties": {
        "observer": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "run_id",
              "count"
            ],
            "properties": {
              "event": {
                "const": "wyoming.mic_frames"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "case",
              "run_id",
              "delegation_id",
              "tools_call_count",
              "commentary_count",
              "screen",
              "transcript",
              "capture_bytes",
              "reply_pcm_bytes",
              "endpoint_to_first_pcm_us"
            ],
            "properties": {
              "event": {
                "const": "m4.case"
              },
              "case": {
                "enum": [
                  "success",
                  "http500"
                ]
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "delegation_id": {
                "type": "string",
                "minLength": 1
              },
              "tools_call_count": {
                "const": 1
              },
              "commentary_count": {
                "const": 1
              },
              "screen": {
                "const": "speaking"
              },
              "transcript": {
                "type": "string",
                "minLength": 1
              },
              "capture_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "reply_pcm_bytes": {
                "const": 9600
              },
              "endpoint_to_first_pcm_us": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    },
    "m1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_before_first_wake",
        "streamed_wakes",
        "bridge_restarts",
        "hassmic_host_restarts",
        "mute_status"
      ],
      "properties": {
        "ready_before_first_wake": {
          "type": "integer",
          "minimum": 0
        },
        "streamed_wakes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bridge_generation",
              "run_id",
              "mic_frames"
            ],
            "properties": {
              "bridge_generation": {
                "type": "integer",
                "minimum": 1
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "mic_frames": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "bridge_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "hassmic_host_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "mute_status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "mute_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "received_frames",
            "forwarded_frames"
          ],
          "properties": {
            "received_frames": {
              "type": "integer",
              "minimum": 0
            },
            "forwarded_frames": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mute_status": {
                "const": "pass"
              }
            },
            "required": [
              "mute_status"
            ]
          },
          "then": {
            "required": [
              "mute_window"
            ]
          }
        }
      ]
    },
    "link_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link",
        "tools_list",
        "tool_call",
        "forced_refresh",
        "replay_rejected",
        "relink_error",
        "restart_grant_kept",
        "unlink"
      ],
      "properties": {
        "link": {
          "type": "integer",
          "minimum": 0
        },
        "tools_list": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call": {
          "type": "integer",
          "minimum": 0
        },
        "forced_refresh": {
          "type": "integer",
          "minimum": 0
        },
        "replay_rejected": {
          "type": "integer",
          "minimum": 0
        },
        "relink_error": {
          "type": "integer",
          "minimum": 0
        },
        "restart_grant_kept": {
          "type": "integer",
          "minimum": 0
        },
        "unlink": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "m6": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui_states",
        "frame_count",
        "frame_ms",
        "return_state",
        "reply_pcm_bytes",
        "host_pcm_bytes",
        "host_nonzero_bytes"
      ],
      "properties": {
        "ui_states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "state"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "type": "object"
              }
            }
          }
        },
        "return_state": {
          "type": "object"
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reply_pcm_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "host_pcm_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "host_nonzero_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "manual_observation"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "manual_observation"
        ]
      }
    }
  ]
}
