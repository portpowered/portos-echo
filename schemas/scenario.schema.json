{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Lab scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "milestone",
    "tiers",
    "setup",
    "steps",
    "budgets",
    "negative"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "T0",
          "T1",
          "T2",
          "T3",
          "T4",
          "T5",
          "T6"
        ]
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "enum": [
            "spoof",
            "portos-pilot"
          ]
        },
        "backend": {
          "enum": [
            "client",
            "muse"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "negative": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/negative"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "say": {
          "type": "string",
          "minLength": 1
        },
        "expect_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_speech_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_screen": {
          "type": "object"
        },
        "press": {
          "type": [
            "string",
            "object"
          ]
        },
        "touch": {
          "type": "object"
        }
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inject"
      ],
      "properties": {
        "inject": {
          "type": "object",
          "minProperties": 1
        },
        "expect_speech_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_trace_absent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_screen": {
          "type": "object"
        }
      },
      "anyOf": [
        {
          "required": [
            "expect_speech_contains"
          ]
        },
        {
          "required": [
            "expect_trace_absent"
          ]
        },
        {
          "required": [
            "expect_trace"
          ]
        },
        {
          "required": [
            "expect_screen"
          ]
        }
      ]
    }
  }
}
